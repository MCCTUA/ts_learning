{
  "compilerOptions": {
    // ให้ tsc มองโค้ดเข้า/ออกแบบชัดเจน
    "rootDir": "src",
    "outDir": "dist",

    // Target / Module สำหรับ Node + ts-node-dev
    "target": "ES2020",
    "module": "commonjs",

    // Environment
    "lib": ["ES2020"],
    "types": ["node"],

    // Debug ได้สะดวกเวลาเรียน
    "sourceMap": true,

    // Type checking เข้มพอดี ๆ
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,

    // ป้องกัน import แปลก ๆ
    "moduleDetection": "force"
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
